# Rust build artifacts
target/

# Backup files generated by rustfmt
**/*.rs.bk

# IDE/editor files
.idea/
.vscode/
*.code-workspace
.codex/

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini

# temp and env-specific files
reports/
saves/
tmp/
config/backups/
plugins/*.fluxplugin
plugins/*.zip
plugins_dev/*
!plugins_dev/.gitkeep
plugin_state.toml

# In-project plugin folders are independent plugin repositories by default.
# Tracked exceptions are the built-in default plugin and sample test fixtures.
src/plugins/*/
!src/plugins/default_plugin/
!src/plugins/flux_api_cell_demo_plugin/
!src/plugins/flux_api_temperature_overlay_plugin/
!src/plugins/flux_api_tick_demo_plugin/
!src/plugins/flux_api_ui_save_demo_plugin/
!src/plugins/flux_stage1_sample_plugin/
!src/plugins/flux_stage7_sample_content_plugin/
